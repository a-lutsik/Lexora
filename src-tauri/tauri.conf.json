{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexora",
  "version": "0.1.0",
  "identifier": "com.lexora.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lexora",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: https://asset.localhost https://images.unsplash.com https://media.giphy.com https://upload.wikimedia.org data:; media-src 'self' blob: mediastream:; connect-src 'self' https://api.openai.com https://generativelanguage.googleapis.com; script-src 'self'; worker-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**", "$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "AI language learning desktop assistant",
    "longDescription": "Local-first vocabulary trainer with SRS reviews, popup translator, and desktop stickers.",
    "copyright": "Copyright © 2026 Lexora",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "localizations/en.lproj/InfoPlist.strings",
        "Resources/en.lproj/ServicesMenu.strings": "localizations/en.lproj/ServicesMenu.strings",
        "Resources/ru.lproj/InfoPlist.strings": "localizations/ru.lproj/InfoPlist.strings",
        "Resources/ru.lproj/ServicesMenu.strings": "localizations/ru.lproj/ServicesMenu.strings",
        "Resources/uk.lproj/InfoPlist.strings": "localizations/uk.lproj/InfoPlist.strings",
        "Resources/uk.lproj/ServicesMenu.strings": "localizations/uk.lproj/ServicesMenu.strings",
        "Resources/es.lproj/InfoPlist.strings": "localizations/es.lproj/InfoPlist.strings",
        "Resources/es.lproj/ServicesMenu.strings": "localizations/es.lproj/ServicesMenu.strings",
        "Resources/fr.lproj/InfoPlist.strings": "localizations/fr.lproj/InfoPlist.strings",
        "Resources/fr.lproj/ServicesMenu.strings": "localizations/fr.lproj/ServicesMenu.strings",
        "Resources/it.lproj/InfoPlist.strings": "localizations/it.lproj/InfoPlist.strings",
        "Resources/it.lproj/ServicesMenu.strings": "localizations/it.lproj/ServicesMenu.strings"
      },
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "background": "images/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
